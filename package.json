{
  "name": "trilha-gratuita",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin:hash": "node scripts/hash-password.js",
    "check": "node --check src/app.js && node --check public/app.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  }
}
